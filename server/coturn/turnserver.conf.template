# Coturn configuration for Matrix Synapse
# Listening port for STUN/TURN (UDP + TCP). Open in ufw: 3478/udp, 3478/tcp, 49152:49200/udp
listening-port=3478

# Only use the public IP. Without this coturn also listens/relays on 127.0.0.1,
# ::1 and the Docker bridges, and may hand out e.g. 172.17.0.1 as relay address,
# which the other caller cannot reach (call connects, but no audio/video)
listening-ip=${TURN_PUBLIC_IP}
relay-ip=${TURN_PUBLIC_IP}

# No TURN over TLS for now (no cert configured, turn_uris only use turn:)
no-tls

# Matrix realm & static secret authentication
realm=${SERVER_NAME}
use-auth-secret
static-auth-secret=${SYNAPSE_TURN_SHARED_SECRET}

# Relay UDP port range (ensure this range is allowed in host firewall)
min-port=49152
max-port=49200

# Security: coturn runs with network_mode: host, so the relay must not reach
# internal or special-purpose networks, nor TCP services on the VM itself
# (e.g. host Postgres on 5432). List from the Synapse TURN docs.
no-tcp-relay
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=100::-100::ffff:ffff:ffff:ffff
denied-peer-ip=2001::-2001:1ff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=2002::-2002:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Allow the TURN server itself as peer, so client -> TURN -> TURN -> client works.
# Needed when both callers can only use relay candidates (e.g. VPN without UDP).
allowed-peer-ip=${TURN_PUBLIC_IP}

# Limit relayed streams to avoid abuse (4 streams per video call)
user-quota=12
total-quota=1200

fingerprint
log-file=stdout
