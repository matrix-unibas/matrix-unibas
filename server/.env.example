# Copy to .env and fill in real values. Never commit .env (the repo is public).
# Generate secrets with: openssl rand -hex 32

# Matrix server name. PERMANENT: user IDs and the signing key depend on it.
SERVER_NAME=matrix.dmi.unibas.ch

# Synapse
SYNAPSE_IMAGE_TAG=v1.157.0
SYNAPSE_HTTP_PORT=8008
SYNAPSE_REPORT_STATS=no
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me
SYNAPSE_MACAROON_SECRET_KEY=change-me
SYNAPSE_FORM_SECRET=change-me
SYNAPSE_TURN_SHARED_SECRET=change-me

# Postgres
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me

# Element Web (served at https://${SERVER_NAME}/ by the host nginx)
# ELEMENT_HTTP_PORT must match the proxy_pass port in nginx/matrix.conf
ELEMENT_IMAGE_TAG=v1.12.30
ELEMENT_HTTP_PORT=8080

# Admin UI (reached via SSH tunnel only)
ADMIN_UI_PORT=8443

# Maubot
MAUBOT_UI_PORT=29316
MAUBOT_ADMIN_PASSWORD=change-me
MAUBOT_ADMIN_PASS=change-me
MAUBOT_IMAGE_TAG=v0.6.0

USERBOTS_ADMIN_PASSWORD=change-me
USERBOTS_CRYPTO_PICKLE_KEY=change-me